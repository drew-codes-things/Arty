#!/bin/bash
# Runs at boot before the guests start (arty-gpu-select.service), and by hand: arty-gpu-select [--dry-run].
set -euo pipefail
CT=${CT:-104}
SETTINGS=${ARTY_GPU_SETTINGS:-/etc/default/arty-gpu-select}
KFD_NODES=/sys/class/kfd/kfd/topology/nodes
DEFAULT_RENDER_GID=992
DEFAULT_VIDEO_GID=44
given_render_gid=${CT_RENDER_GID:-}
given_video_gid=${CT_VIDEO_GID:-}
if [ -r "$SETTINGS" ]; then
  # shellcheck source=/dev/null
  . "$SETTINGS"
fi
CT_RENDER_GID=${given_render_gid:-${CT_RENDER_GID:-$DEFAULT_RENDER_GID}}
CT_VIDEO_GID=${given_video_gid:-${CT_VIDEO_GID:-$DEFAULT_VIDEO_GID}}
for gid in "$CT_RENDER_GID" "$CT_VIDEO_GID"; do
  if ! [[ "$gid" =~ ^[0-9]+$ ]]; then
    echo "arty-gpu-select: group id '$gid' (CT_RENDER_GID or CT_VIDEO_GID, from the environment or $SETTINGS) is not a number" >&2
    exit 1
  fi
done
CONF=/etc/pve/lxc/$CT.conf
DRY_RUN=false
SHOW_KIND=false
SHOW_GFX_TARGET=false
[ "${1:-}" = "--dry-run" ] && DRY_RUN=true
[ "${1:-}" = "--kind" ] && SHOW_KIND=true
[ "${1:-}" = "--gfx-target" ] && SHOW_GFX_TARGET=true

say() { echo "$*"; logger -t arty-gpu-select -- "$*"; }

gfx_target() {
  local version
  version=$(awk '$1 == "gfx_target_version" && $2 > 0 { print $2; exit }' "$KFD_NODES"/*/properties 2>/dev/null || true)
  [[ "$version" =~ ^[0-9]+$ ]] || return 0
  printf 'gfx%d%x%x\n' $((version / 10000)) $((version / 100 % 100)) $((version % 100))
}

if $SHOW_GFX_TARGET; then
  gfx_target
  exit 0
fi

own_settings() { sed -n '/^\[/q;p' "$CONF"; }

nvidia_devices() {
  local node
  for node in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-caps/nvidia-cap*; do
    [ -c "$node" ] && echo "$node"
  done
}

amd_render_node() {
  local render
  for render in /sys/class/drm/renderD*; do
    if [ "$(basename "$(readlink -f "$render/device/driver")")" = amdgpu ]; then
      echo "$render"
      return
    fi
  done
}

amd_devices() {
  local render=$1 card
  if [ -c /dev/kfd ]; then
    echo "/dev/kfd,gid=$CT_RENDER_GID"
  fi
  echo "/dev/dri/$(basename "$render"),gid=$CT_RENDER_GID"
  for card in "$render"/device/drm/card*; do
    if [ -e "$card" ]; then
      echo "/dev/dri/$(basename "$card"),gid=$CT_VIDEO_GID"
      return
    fi
  done
}

if [ -c /dev/nvidia0 ]; then
  kind=NVIDIA; short_kind=nvidia; mapfile -t wanted < <(nvidia_devices)
else
  render=$(amd_render_node)
  if [ -n "$render" ] && [ -c /dev/kfd ]; then
    kind="AMD (ROCm: /dev/kfd and the render node)"; short_kind=amd-rocm; mapfile -t wanted < <(amd_devices "$render")
  elif [ -n "$render" ]; then
    kind="AMD (Vulkan only: no /dev/kfd on the host)"; short_kind=amd-vulkan; mapfile -t wanted < <(amd_devices "$render")
  else
    wanted=(); short_kind=none; kind="no GPU (no NVIDIA or AMD card is fitted; ArtyEngine runs on the CPU)"
  fi
fi
if $SHOW_KIND; then
  echo "$short_kind"
  exit 0
fi

if [ ! -r "$CONF" ]; then
  say "CT $CT has no readable config at $CONF; nothing changed"
  exit 1
fi
mapfile -t current < <(own_settings | sed -nE 's/^dev[0-9]+: *//p')
if [ "${wanted[*]:-}" = "${current[*]:-}" ]; then
  say "CT $CT already has the $kind devices"
  exit 0
fi
say "CT $CT: switching to $kind (${wanted[*]:-none}; was ${current[*]:-none})"
$DRY_RUN && exit 0

if [ "$(pct status "$CT" | awk '{print $2}')" = running ]; then
  say "CT $CT is running: stop it and run arty-gpu-select again (it runs by itself at boot)"
  exit 1
fi
old=$(own_settings | { grep -oE '^dev[0-9]+' || [ $? -eq 1 ]; } | paste -sd, -)
[ -n "$old" ] && pct set "$CT" -delete "$old"
args=()
for index in "${!wanted[@]}"; do args+=("-dev$index" "${wanted[$index]}"); done
[ ${#args[@]} -gt 0 ] && pct set "$CT" "${args[@]}"
say "CT $CT now has the $kind devices"
