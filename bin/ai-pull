#!/bin/sh
. "$(dirname "$0")/ai-engine-lib"

list_models() {
  engine_call GET /api/tags 30 || exit 1
  if [ "$status" != 200 ]; then
    echo "The engine couldn't list its models: $(engine_error)"
    exit 1
  fi
  printf '%s' "$reply" | jq -r '.models | sort_by(.name)[] | "  \(.name)"'
}

FROM_USAGE="Usage: ai-pull <model> --from hf.co/<user>/<repo>:<quant>   (one model, one source)"

refuse_usage() {
  echo "$FROM_USAGE"
  exit 2
}

pull_from_source() {
  if [ $# -eq 2 ]; then
    case "$2" in --from=*) set -- "$1" --from "${2#--from=}" ;; esac
    case "$1" in --from=*) set -- "$2" --from "${1#--from=}" ;; esac
  fi
  if [ $# -eq 3 ] && [ "$2" = --from ] && [ -n "$3" ]; then
    model=$1 source=$3
  elif [ $# -eq 3 ] && [ "$1" = --from ] && [ -n "$2" ] && [ "$3" != --from ]; then
    model=$3 source=$2
  else
    refuse_usage
  fi
  case "$model" in -*) refuse_usage ;; esac
  echo "Downloading $source as $model..."
  pull_model "$model" "$source" || exit 1
  echo
  echo "Installed now:"
  list_models
  exit 0
}

show_help() {
  cat <<'HELP'
Usage: ai-pull <model> [more models...]
       ai-pull <model> --from hf.co/<user>/<repo>:<quant>

Downloads models into Arty's engine from Hugging Face: the engine's short names such as qwen3:14b,
or any GGUF as hf.co/<user>/<repo>:<quant>. With --from (or --from=<source>), that repository and quant are
installed under the short name given (a model already installed from the same source is kept as it is; from
another source it is replaced once the new download has been checked, and the old copy's template, system
prompt and parameters are not carried over). Ctrl-C stops the download.
Good fits for the RTX 3060 (12 GB):
  qwen3:14b          the brain: chat, code and tool use (recommended first)
  mimo-v2.6:9b       pictures, so Arty can look at the screen and your photos
  nomic-embed-text   embeddings, for searching the document library by meaning
Models above 14B run partly on the CPU and are slow.

Installed now:
HELP
  list_models
  exit 0
}

[ $# -gt 0 ] || show_help
from_given=no
for argument in "$@"; do
  case "$argument" in
    -h | --help) show_help ;;
    --from | --from=*) from_given=yes ;;
    -*)
      echo "ai-pull doesn't know the option $argument; nothing was downloaded"
      refuse_usage
      ;;
  esac
done
[ "$from_given" = no ] || pull_from_source "$@"
for model in "$@"; do
  echo "Downloading $model..."
  pull_model "$model" || exit 1
done
echo
echo "Installed now:"
list_models
