#!/bin/sh
set -eu
. "$(dirname "$0")/ai-engine-lib"
CONFIG=${BRAIN_CONFIG:-/srv/ai/brain/brain.json}

show_model() {
  engine_call POST /api/show 60 "$(jq -cn --arg model "$1" '{model: $model}')"
}

current=$(jq -r .model "$CONFIG")

if [ $# -ne 1 ]; then
  echo "Usage: ai-use <model>"
  echo "Switches Arty to another model, downloading it into the engine if needed."
  echo "Current model: $current"
  exit 0
fi

model=$1
if [ "$model" = "$current" ]; then
  echo "Arty already uses $model."
  exit 0
fi
allowed=$(jq -r '(.arty_models // []) | join(", ")' "$CONFIG")
if [ -n "$allowed" ] && ! jq -e --arg model "$model" '(.arty_models // []) | index($model) != null or index($model | sub(":latest$"; "")) != null' "$CONFIG" >/dev/null; then
  echo "Not switching: $model isn't one of Arty's models ($allowed)."
  echo "To use it, add it to arty_models in $CONFIG first."
  exit 1
fi
show_model "$model" || exit 1
if [ "$status" = 404 ]; then
  echo "Downloading $model..."
  if ! pull_model "$model"; then
    echo "Not switching."
    exit 1
  fi
  show_model "$model" || exit 1
fi
if [ "$status" != 200 ]; then
  echo "Not switching: the engine couldn't read $model: $(engine_error)"
  exit 1
fi
if [ "$(printf '%s' "$reply" | jq -r '.runnable != false')" != true ]; then
  echo "Not switching: the engine can't run $model, so every chat would fail."
  exit 1
fi

capabilities=$(printf '%s' "$reply" | jq -r '(.capabilities // [])[]')
if ! echo "$capabilities" | grep -qx tools; then
  if [ "$(jq -r '.allow_toolless_models // false' "$CONFIG")" != true ]; then
    echo "Not switching: $model can't use tools, so Arty would lose memory saving, its computer and the browser."
    echo "Pick a model that can use tools, or allow it anyway with: ai-toolless on"
    exit 1
  fi
  echo "Note: $model can't use tools; Arty will chat with its persona and memory only."
fi

updated=$(mktemp)
jq --arg model "$model" '.model = $model' "$CONFIG" > "$updated"
install -m 644 "$updated" "$CONFIG"
rm -f "$updated"
echo "Arty now uses $model (from your next message). Previous model: $current"
if echo "$capabilities" | grep -qx vision; then
  echo "$model can also see images."
fi
echo "Switch back any time with: ai-use $current"
