  "weather": {
    "place": "London",
    "latitude": 51.507,
    "longitude": -0.128
  },
  "lookups": [
    {
      "pattern": "\\b(new|unread|any) (e-?mails?|mail)\\b|\\bmy (inbox|e-?mails?)\\b|\\bcheck (my )?(e-?mails?|inbox|mail)\\b",
      "tool": "workspace__gmail_unread",
      "arguments": {
        "max_emails": 15
      }
    },
    {
      "pattern": "\\b(minecraft|game servers?|pufferpanel|puffer)\\b",
      "tool": "homelab__pufferpanel_servers"
    },
    {
      "pattern": "\\b(ips?|ip address(es)?|vms?|containers?|proxmox|servmox|homelab|server status|servers?)\\b",
      "tool": "homelab__proxmox_status"
    },
    {
      "pattern": "^(?!.*\\b((on|in) your (computer|desktop|pc|terminal)|run (a |the )?command)\\b).*?\\b(is (it|\\w+) (down|up|working)|websites?|services? (down|up|status)|uptime)\\b",
      "tool": "homelab__service_status"
    },
    {
      "pattern": "\\b(weather|forecast|rain(ing|y)?|snow(ing)?|temperature|umbrella|coat|sunny|windy)\\b",
      "tool": "weather",
      "arguments": {
        "days": 2
      }
    },
    {
      "pattern": "\\b(calendar|what'?s on|my (day|week)|appointments?|schedule for|busy (today|tomorrow))\\b",
      "tool": "calendar_events",
      "skip_for_changes": true,
      "arguments": {
        "days": 7
      }
    },
    {
      "pattern": "\\b(deadlines?|due (date|soon|in)|assignments?|coursework)\\b",
      "tool": "deadlines_show",
      "skip_for_changes": true
    },
    {
      "pattern": "\\b(shopping list|to-?do list|my lists?|what'?s on my list)\\b",
      "tool": "list_show",
      "skip_for_changes": true
    },
    {
      "pattern": "\\b(revision progress|how('?s| is) my revision|quiz progress)\\b",
      "tool": "quiz_progress"
    },
    {
      "pattern": "\\b(how many (days|weeks|sleeps)|how long (until|till|to|is it until)|(days|weeks) (until|till|to go|left|between)|what day (of the week )?(is|was|will|does)|which day (is|was|does)|what('s| is) the date|what date (is|will|was)|when is (easter|christmas|halloween|bonfire night|new year)|\\d+ (days|weeks|months) (from|after|ago)|in \\d+ (days|weeks|months))\\b",
      "tool": "date_facts",
      "arguments": {
        "text": "{message}"
      }
    },
    {
      "pattern": "(?:[$£€]\\s?\\d|\\b\\d[\\d,.]*\\s*(?:us dollars?|dollars?|bucks|pounds?|quid|sterling|euros?|yen|usd|gbp|eur|cad|aud|jpy|chf)\\b).{0,20}\\b(?:in|to|into)\\s+(?:us dollars?|dollars?|bucks|pounds?|quid|sterling|euros?|yen|usd|gbp|eur|cad|aud|jpy|chf)\\b",
      "tool": "currency_facts",
      "arguments": {
        "text": "{message}"
      }
    },
    {
      "pattern": "\\b(look at|check|see|describe|what('s| is) on) (your|the) (desktop|screen|wallpaper)\\b|\\bwhat does your (desktop|wallpaper|screen) look like\\b",
      "tool": "workspace__look_at_desktop",
      "arguments": {
        "question": "{message}"
      }
    }
  ],
