[Unit]
Description=Arty's docs library: search and read the downloaded documentation (loopback and the Docker network only)
After=network-online.target docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /srv/ai/doclib/server.py --db /srv/ai/docs-library/docs.db --bridge docker0 --port 8889
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
