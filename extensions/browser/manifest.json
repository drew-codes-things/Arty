{
  "manifest_version": 3,
  "key": "",
  "name": "Arty for Chrome",
  "version": "1.4",
  "description": "Lets Arty Desktop use this browser for you: open, read, click and type in your tabs.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "arty-browser@arty.home", "strict_min_version": "128.0" } },
  "action": { "default_title": "Arty for Chrome", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png" } }
}
