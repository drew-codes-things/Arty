{
  "manifest_version": 3,
  "name": "Arty for Chrome",
  "version": "1.1",
  "description": "Lets Arty Desktop use this browser for you: open, read, click and type in your tabs.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Arty for Chrome", "default_icon": { "16": "icon16.png", "48": "icon48.png" } }
}
